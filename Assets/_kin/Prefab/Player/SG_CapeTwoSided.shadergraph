    },
    "m_Name": "Character Toon Lighting",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -350,
            "y": 100,
            "width": 301.0001220703125,
            "height": 334.0000915527344
        }
    },
    "m_Slots": [
        {
            "m_Id": "92c90c92a9094351a171d3cacf87b3d2"
        },
        {
            "m_Id": "4f88637c225247afb11fafbd87d13c73"
        },
        {
            "m_Id": "2088706295bf4e789750e975d709e7c4"
        },
        {
            "m_Id": "a68b7ac81b924c4983a9874869024af8"
        },
        {
            "m_Id": "d2d78f405089495e9dd1be5537e5979d"
        },
        {
            "m_Id": "44fab51c85864daa80cfdec9b712a4e6"
        },
        {
            "m_Id": "8e6dde485a7048339718f368d700c676"
        },
        {
            "m_Id": "c4b39f63408349b6b231e93b5000a2c0"
        },
        {
            "m_Id": "1150532be519488d81806938da127701"
        },
        {
            "m_Id": "e97f179712f2418fb8cd2320f2c96218"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CharacterToon",
    "m_FunctionSource": "",
    "m_FunctionBody": "float3 L = normalize(float3(0.5,0.7,0.3));\nfloat3 lightColor = float3(1,1,1);\nfloat shadow = 1;\n#ifndef SHADERGRAPH_PREVIEW\nfloat4 shadowCoord;\n#if defined(_MAIN_LIGHT_SHADOWS_SCREEN)\nshadowCoord = ComputeScreenPos(TransformWorldToHClip(PositionWS));\n#else\nshadowCoord = TransformWorldToShadowCoord(PositionWS);\n#endif\nLight mainLight = GetMainLight(shadowCoord);\nL = mainLight.direction;\nlightColor = mainLight.color;\nshadow = mainLight.shadowAttenuation * mainLight.distanceAttenuation;\n#endif\nfloat ndl = saturate(dot(normalize(NormalWS), L));\nfloat width = max(Softness, 0.0001);\nfloat band = smoothstep(Threshold-width*0.5, Threshold+width*0.5, ndl);\nfloat lit = band * shadow;\nfloat3 shade = lerp(float3(1,1,1), ShadowColor.rgb, saturate(ShadeStrength));\nfloat3 albedo = SAMPLE_TEXTURE2D(BaseMap.tex, BaseMap.samplerstate, UV).rgb * BaseColor.rgb;\nColor = albedo * lerp(shade, float3(1,1,1), lit) * lightColor;\n"
}

