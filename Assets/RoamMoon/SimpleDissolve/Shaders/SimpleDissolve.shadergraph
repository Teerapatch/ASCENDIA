    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d072c08a249b7255d2f77d324ef33322",
    "m_Title": "Cut and edge",
    "m_Content": "The cut sweeps the field with Amount, the edge band is what lies just behind it. Burn recolors the band from white hot to soot.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
