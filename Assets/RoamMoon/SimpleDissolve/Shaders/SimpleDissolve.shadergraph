{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "673588c78768014fcff19b282aac26cd",
    "m_Title": "Simple Dissolve",
    "m_Content": "Six dissolve modes in plain Shader Graph nodes. Every noise here is procedural, there are no textures. Mode picks which field decides what vanishes first.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 0,
        "y": -330,
        "width": 420,
        "height": 130
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "5b305194d4c82f81746e653fbfb6b19b",
    "m_Title": "Fields",
    "m_Content": "Turbulence, Grain, Cells and Pixel Blocks are the base patterns. Burn, Directional and Radial combine them.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 2130,
        "y": -330,
        "width": 420,
