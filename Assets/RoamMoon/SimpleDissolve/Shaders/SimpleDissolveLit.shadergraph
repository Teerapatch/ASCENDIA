{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6ec083f5d12107c7053f595c11c42fe2",
    "m_Title": "Simple Dissolve",
    "m_Content": "Six dissolve modes in plain Shader Graph nodes. Every noise here is procedural, there are no textures. Mode picks which field decides what vanishes first.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 0,
        "y": -330,
        "width": 420,
        "height": 130
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "0cb39b6dc8905ea427706ff06be7b07e",
    "m_Title": "Fields",
    "m_Content": "Turbulence, Grain, Cells and Pixel Blocks are the base patterns. Burn, Directional and Radial combine them.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 2130,
        "y": -330,
        "width": 420,
        "height": 130
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9fafd3be69592e47003008c4e33fcf8c",
    "m_Title": "Cut and edge",
    "m_Content": "The cut sweeps the field with Amount, the edge band is what lies just behind it. Burn recolors the band from white hot to soot.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 8700,
